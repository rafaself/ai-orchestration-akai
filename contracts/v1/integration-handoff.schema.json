{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rafaself/ai-orchestration-akai/contracts/v1/integration-handoff.schema.json",
  "title": "Integration handoff",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "status", "plan_sha256", "executor_result_sha256", "review_result_sha256", "integration_policy_ref", "handoff_summary", "validation_evidence"],
  "properties": {
    "schema_version": { "type": "string", "enum": ["1.0"] },
    "run_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
    "status": { "type": "string", "enum": ["ready_for_integration"] },
    "plan_sha256": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" },
    "executor_result_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "review_result_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "integration_policy_ref": { "type": "string", "minLength": 1 },
    "handoff_summary": { "type": "string", "minLength": 1 },
    "validation_evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  }
}
