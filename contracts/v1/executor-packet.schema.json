{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rafaself/ai-orchestration-akai/contracts/v1/executor-packet.schema.json",
  "title": "Executor packet",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "planning_decision", "remediation_pass"],
  "properties": {
    "schema_version": { "type": "string", "enum": ["1.0"] },
    "run_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
    "planning_decision": { "type": "string", "enum": ["required", "skipped"] },
    "skip_rationale": { "type": "string", "minLength": 1 },
    "plan_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "remediation_pass": { "type": "integer", "minimum": 0 },
    "task_instructions": { "type": "string", "minLength": 1 }
  }
}
