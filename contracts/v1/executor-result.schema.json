{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rafaself/ai-orchestration-akai/contracts/v1/executor-result.schema.json",
  "title": "Executor result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "plan_sha256", "remediation_pass", "step_results", "deviations", "validation_evidence"],
  "properties": {
    "schema_version": { "type": "string", "enum": ["1.0"] },
    "run_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
    "plan_sha256": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" },
    "remediation_pass": { "type": "integer", "minimum": 0 },
    "step_results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step_id", "status", "evidence"],
        "properties": {
          "step_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
          "status": { "type": "string", "enum": ["completed", "partial", "deferred", "blocked", "skipped"] },
          "evidence": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "deviations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["summary", "reason"],
        "properties": {
          "summary": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "validation_evidence": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}
