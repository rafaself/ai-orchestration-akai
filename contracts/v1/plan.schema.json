{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rafaself/ai-orchestration-akai/contracts/v1/plan.schema.json",
  "title": "Proposed plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "plan_id", "summary", "scope", "assumptions", "risks", "requires_human_approval", "steps", "validation_strategy"],
  "properties": {
    "schema_version": { "type": "string", "enum": ["1.0"] },
    "run_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
    "plan_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
    "summary": { "type": "string", "minLength": 1 },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["included", "excluded"],
      "properties": {
        "included": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "excluded": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "assumptions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "description"],
        "properties": {
          "severity": { "type": "string", "enum": ["low", "medium", "high"] },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },
    "requires_human_approval": { "type": "boolean" },
    "escalation_reason": { "type": "string", "minLength": 1 },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step_id", "action", "acceptance_criteria", "validation"],
        "properties": {
          "step_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
          "action": { "type": "string", "minLength": 1 },
          "acceptance_criteria": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "validation": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "validation_strategy": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}
