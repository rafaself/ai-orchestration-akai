{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rafaself/ai-orchestration-akai/contracts/v1/review-result.schema.json",
  "title": "Review result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "plan_sha256", "executor_result_sha256", "remediation_pass", "outcome", "findings"],
  "properties": {
    "schema_version": { "type": "string", "enum": ["1.0"] },
    "run_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
    "plan_sha256": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" },
    "executor_result_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "remediation_pass": { "type": "integer", "minimum": 0 },
    "outcome": { "type": "string", "enum": ["accepted", "changes_requested", "escalate"] },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["finding_id", "severity", "summary", "evidence"],
        "properties": {
          "finding_id": { "type": "string", "minLength": 1 },
          "severity": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
          "summary": { "type": "string", "minLength": 1 },
          "evidence": { "type": "string", "minLength": 1 }
        }
      }
    },
    "human_resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approver_role", "decision", "notes"],
      "properties": {
        "approver_role": { "type": "string", "enum": ["human"] },
        "decision": { "type": "string", "enum": ["accepted", "blocked"] },
        "notes": { "type": "string", "minLength": 1 }
      }
    }
  }
}
