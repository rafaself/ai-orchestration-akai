{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rafaself/ai-orchestration-akai/contracts/v1/run.schema.json",
  "title": "Orchestration run policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "task_ref", "planning", "approval", "max_remediation_passes", "integration_policy_ref"],
  "properties": {
    "schema_version": { "type": "string", "enum": ["1.0"] },
    "run_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
    "task_ref": { "type": "string", "minLength": 1 },
    "planning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision"],
      "properties": {
        "decision": { "type": "string", "enum": ["required", "skipped"] },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "type": "string", "enum": ["coordinator", "human"] }
      }
    },
    "max_remediation_passes": { "type": "integer", "minimum": 0 },
    "integration_policy_ref": { "type": "string", "minLength": 1 }
  }
}
